# Godot 4+ specific ignores
.godot/
/android/

# Экспортные бандлы и бинарники (не должны попадать в репозиторий, см. ARC-008/ARC-065)
*.exe
*.pck
*.console.exe
/web/
/builds/
/_to_delete/

# Реальный export_path обоих текущих пресетов (export_presets.cfg) — "./GTA_VI.*" в корне
# проекта, а не в /web//builds/. Если базовое имя экспорта сменится — обновить и это правило.
/GTA_VI.*

# GUT (ARC-072): служебные файлы, которые движок/плагин пишет в корень res://
# при работе с панелью тестов в редакторе или при локальном прогоне с JUnit-отчётом.
.gut_editor_config.json
/gut_results.xml

# OS
.DS_Store
Thumbs.db
