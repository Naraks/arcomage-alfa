# Godot 4+ specific ignores
.godot/
/android/

# Экспортные бандлы и бинарники (не должны попадать в репозиторий, см. ARC-008/ARC-065)
*.exe
*.pck
*.console.exe
/web/
/builds/
/_to_delete/

# GUT (ARC-072): служебные файлы, которые движок/плагин пишет в корень res://
# при работе с панелью тестов в редакторе или при локальном прогоне с JUnit-отчётом.
.gut_editor_config.json
/gut_results.xml

# Версия сборки (ARC-069): пишется в CI перед экспортом из `git describe`,
# в репозитории не хранится — см. core/build_version.gd.
/build_version.json

# Отчёты tools/battle_simulator.gd (ARC-054/ARC-023): CSV пишутся по умолчанию
# в res:// (project root), Godot-редактор тут же импортирует .csv как файл
# перевода (.import + *.<колонка>.translation на каждую колонку) — мусор,
# который не должен попадать в репозиторий и путается под ногами в
# FileSystem-панели редактора.
/balance_report*.csv
/balance_report*.csv.import
/balance_report*.translation

# ARC-091: отклонённые/промежуточные генерации арта — оставлены на диске как
# история экспериментов (см. блокквоты ARC-091 в docs/dev_plan_tickets.md),
# но не должны попадать в репозиторий — не подключены ни к одной сцене.
# - background_workshop.png: первая генерация фона битвы (интерьер мастерской),
#   отклонена по фидбэку "башни не могут быть в помещении", заменена на
#   background_battlefield.png (уже в репозитории, реально используется).
# - name_banner.png: лента названия карты, узел NameBanner убран из card.tscn
#   при переходе на чернильный текст без ленты.
# - cards/source/: сырые неоткадрированные генерации (goblin1-4, tracker1) —
#   рабочий материал, из которого вырезаны реальные art/cards/goblin.png и
#   art/cards/beast_hunter.png.
/art/battle/background_workshop.png
/art/battle/background_workshop.png.import
/art/card_frame/name_banner.png
/art/card_frame/name_banner.png.import
/art/cards/source/

# OS
.DS_Store
Thumbs.db
