[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://data/resources/event_data.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
event_title = "Раненый путник"
event_description = "У дороги лежит раненый рыцарь. Ему нужны припасы, чтобы снова встать на ноги."
options = Array[Dictionary]([{
"text": "Купить припасы за 3 золота",
"outcomes": [{"chance": 100, "result_text": "Рыцарь благодарит вас и присоединяется к походу.", "effects": [{"type": "gold", "value": -3}, {"type": "add_card", "card_path": "res://data/cards/knight_card.tres"}]}]
}, {
"text": "Показать дорогу к ближайшему поселению",
"outcomes": [{"chance": 100, "result_text": "Путник благодарит за совет, а вы продолжаете путь.", "effects": []}]
}])
