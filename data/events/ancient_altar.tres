[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://data/resources/event_data.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
event_title = "Древний алтарь"
event_description = "Посреди руин стоит алтарь, покрытый рунами. Кажется, он всё ещё хранит частицу былой силы."
options = Array[Dictionary]([{
"text": "Принести в жертву 10 золота",
"outcomes": [{
"chance": 100,
"result_text": "Алтарь вспыхивает светом — вы чувствуете, как крепнет фундамент вашей Башни.",
"effects": [{"type": "gold", "value": -10}, {"type": "run_tower_bonus", "value": 3}]
}]
}, {
"text": "Не трогать алтарь",
"outcomes": [{
"chance": 100,
"result_text": "Вы решаете не испытывать судьбу.",
"effects": []
}]
}])
