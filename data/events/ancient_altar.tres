[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://data/resources/event_data.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
event_title = "Древний алтарь"
event_description = "Посреди руин стоит алтарь с двумя чашами: каменной и хрустальной. Руны требуют подношения."
options = Array[Dictionary]([{
"text": "Положить 10 золота в каменную чашу",
"outcomes": [{"chance": 100, "result_text": "Руны укрепляют фундамент вашей Башни.", "effects": [{"type": "gold", "value": -10}, {"type": "run_tower_bonus", "value": 4}]}]
}, {
"text": "Положить 7 золота в хрустальную чашу",
"outcomes": [{"chance": 100, "result_text": "Хрусталь наполняет магические каналы новой силой.", "effects": [{"type": "gold", "value": -7}, {"type": "run_magic_bonus", "value": 1}]}]
}, {
"text": "Не трогать алтарь",
"outcomes": [{"chance": 100, "result_text": "Вы решаете не будить древнюю силу.", "effects": []}]
}])
