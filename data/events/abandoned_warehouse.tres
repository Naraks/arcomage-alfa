[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://data/resources/event_data.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
event_title = "Заброшенный склад"
event_description = "У дороги стоит полуразрушенный склад. Внутри поблёскивают сундуки, но прогнивший пол едва держится."
options = Array[Dictionary]([{
"text": "Обыскать склад",
"outcomes": [{"chance": 70, "result_text": "Под досками нашёлся кошель с монетами.", "effects": [{"type": "gold", "value": 12}]}, {"chance": 30, "result_text": "Пол рухнул, и часть припасов пришлось бросить.", "effects": [{"type": "gold", "value": -6}]}]
}, {
"text": "Не рисковать",
"outcomes": [{"chance": 100, "result_text": "Вы оставляете ненадёжное здание позади.", "effects": []}]
}])
