[gd_resource type="Resource" script_class="EventData" format=3]
[ext_resource type="Script" path="res://data/resources/event_data.gd" id="1_event"]
[resource]
script = ExtResource("1_event")
event_title = "Лунный колодец"
event_description = "Вода в старом колодце отражает не небо, а возможное будущее. На бортике вырезаны руны подношения."
options = Array[Dictionary]([{
"text": "Бросить 7 золота в воду",
"outcomes": [{"chance": 100, "result_text": "Лунный свет усиливает Магию на весь забег.", "effects": [{"type": "gold", "value": -7}, {"type": "run_magic_bonus", "value": 1}]}]
}, {
"text": "Купить руну за 3 золота",
"outcomes": [{"chance": 100, "result_text": "На ладони проявляется карта «Ясновидение».", "effects": [{"type": "gold", "value": -3}, {"type": "add_card", "card_path": "res://data/cards/gem_13.tres"}]}]
}, {
"text": "Не смотреть в будущее",
"outcomes": [{"chance": 100, "result_text": "Вы оставляете колодец и его тайны.", "effects": []}]
}])
